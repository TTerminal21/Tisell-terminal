# Copy this file to .env and fill in the values.
#   cp .env.example .env
# .env is git-ignored. .env.example documents names only - never real values.
#
# One .env at the repo root serves every layer: the data layer reads it via
# data-layer/config.py, the dashboard via dashboard/app.py.
#
# All of these are live as of v1 item 2. A provider with no key is skipped by
# the fallback chain rather than tried and failed, so a partly-filled file is a
# supported state - you just get fewer fallbacks.

# --- Core data sources (need a key) ---------------------------------------

# Tiingo - prices + fundamentals. Primary price source.
# https://www.tiingo.com/account/api/token
TIINGO_API_KEY=

# Financial Modeling Prep - fundamentals, ratios, DCF. Free tier ~250 calls/day.
# https://site.financialmodelingprep.com/developer/docs/dashboard
FMP_API_KEY=

# FRED - all macro/rates data. Free, no meaningful rate limit.
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Fiscal AI - company KPIs and segment data. Free tier ~100 companies/250 req/day.
# https://fiscal.ai
FISCAL_AI_API_KEY=

# --- Fallback price sources (optional, need a key) ------------------------

# Twelve Data - https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=

# Alpaca Market Data - https://app.alpaca.markets  (two values, key + secret)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Keyless sources ------------------------------------------------------

# SEC EDGAR needs no key, but does require a descriptive User-Agent naming you
# and a contact address, or it returns 403. Format: "Name email@example.com".
# Leave it blank and sec_edgar is simply skipped in the fundamentals chain.
SEC_EDGAR_USER_AGENT=

# yfinance, the CNBV XBRL portal and BMV's archive need no credentials at all.
# Databento is pay-as-you-go and not needed until derivatives work starts.

# --- Storage --------------------------------------------------------------

# Optional. Defaults to data-layer/terminal.duckdb next to the fetch scripts.
DUCKDB_PATH=

# Optional. Defaults to data-layer/watchlist.json.
WATCHLIST_PATH=

# Optional. Where backup.py writes copies of the DuckDB file. Defaults to ./backups.
BACKUP_DIR=

# --- Interface layer ------------------------------------------------------

# Shared secret between the data layer and its clients. Leave blank to disable
# the check (fine for a single machine). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DATA_LAYER_API_KEY=

# Where the dashboard and TUI reach the FastAPI data layer. Same machine, so
# localhost; point it at another host's address if you ever split the layers.
DATA_LAYER_URL=http://127.0.0.1:8000
